# Tenacious Sales Bench – Week 11 Interim
# Copy to .env and fill in real values. Never commit .env.

# LLM provider (used by generation_scripts and scoring_evaluator)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model aliases used in generation scripts
JUDGE_MODEL=openai/gpt-4o-mini
SYNTHESIS_MODEL=openai/gpt-4o-mini
ADVERSARIAL_MODEL=anthropic/claude-3-haiku

# Benchmark paths (defaults are relative to repo root)
BENCH_ROOT=tenacious_bench_v0.1
TRAIN_DIR=tenacious_bench_v0.1/train
DEV_DIR=tenacious_bench_v0.1/dev
HELD_OUT_DIR=tenacious_bench_v0.1/held_out

# Scoring thresholds
ICP_ABSTAIN_THRESHOLD=0.62
SIGNAL_CONFIDENCE_MODE=confidence_aware   # confidence_aware | binary_threshold | no_confidence

# Contamination check
NGRAM_OVERLAP_THRESHOLD=0.30
EMBEDDING_SIM_THRESHOLD=0.85
