{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tenacious.bench/schema/v0.1/task.schema.json",
  "title": "TenaciousBench Task Schema v0.1",
  "description": "Schema for a single evaluation task in the Tenacious B2B Outbound Sales Benchmark.",
  "type": "object",
  "required": [
    "task_id",
    "metadata",
    "source_mode",
    "difficulty",
    "input",
    "candidate_output",
    "ground_truth",
    "scoring_rubric",
    "evaluator_config"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^TB-(TRAIN|DEV|HELD)-[0-9]{3}$",
      "description": "Unique task identifier. Prefix encodes split membership.",
      "examples": ["TB-DEV-001", "TB-TRAIN-042", "TB-HELD-011"]
    },
    "metadata": {
      "type": "object",
      "required": [
        "dimension",
        "created_by",
        "created_at",
        "contamination_checked",
        "scoring_type",
        "probe_ref"
      ],
      "properties": {
        "dimension": {
          "type": "string",
          "enum": [
            "signal_grounded_personalization",
            "confidence_aware_phrasing",
            "hallucination_avoidance",
            "brand_safe_tone",
            "multi_turn_objection_handling",
            "cta_behavior",
            "icp_targeting_accuracy",
            "competitor_gap_reasoning",
            "pricing_discipline",
            "thread_continuation_coherence"
          ]
        },
        "created_by": {
          "type": "string",
          "enum": ["trace_derived", "programmatic", "multi_llm_synthesis", "hand_authored_adversarial"]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "contamination_checked": {
          "type": "boolean"
        },
        "scoring_type": {
          "type": "string",
          "enum": ["rubric_5pt", "binary_pass_fail", "multi_label"]
        },
        "probe_ref": {
          "type": ["string", "null"],
          "description": "Week 10 probe ID this task was derived from, or null for synthetic tasks.",
          "pattern": "^P[0-9]{2}$"
        },
        "industry": {
          "type": "string"
        },
        "company_size": {
          "type": "string",
          "enum": ["startup", "smb", "mid_market", "enterprise"]
        },
        "icp_confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      },
      "additionalProperties": false
    },
    "source_mode": {
      "type": "string",
      "enum": ["trace_derived", "programmatic", "multi_llm_synthesis", "hand_authored_adversarial"]
    },
    "difficulty": {
      "type": "string",
      "enum": ["easy", "medium", "hard", "adversarial"],
      "description": "easy = single signal check; medium = multi-signal synthesis; hard = multi-turn or cross-system; adversarial = probe-derived edge case."
    },
    "input": {
      "type": "object",
      "required": ["company_context", "signal_brief", "channel", "thread_history"],
      "properties": {
        "company_context": {
          "type": "object",
          "required": ["company_id", "company_name", "industry", "funding_stage", "employee_count", "ai_maturity_score"],
          "properties": {
            "company_id": {"type": "string"},
            "company_name": {"type": "string"},
            "industry": {"type": "string"},
            "funding_stage": {"type": "string"},
            "employee_count": {"type": "integer"},
            "ai_maturity_score": {"type": "number", "minimum": 0, "maximum": 3}
          }
        },
        "signal_brief": {
          "type": "object",
          "description": "Subset of hiring_signal_brief + competitor_gap_brief.",
          "properties": {
            "icp_confidence": {"type": "number"},
            "icp_segment": {"type": ["string", "null"]},
            "hiring_velocity_label": {"type": "string"},
            "open_roles_today": {"type": "integer"},
            "open_roles_60d_ago": {"type": "integer"},
            "honesty_flags": {"type": "array", "items": {"type": "string"}},
            "competitor_gap_summary": {"type": "string"},
            "signal_date": {"type": "string", "format": "date"}
          }
        },
        "channel": {
          "type": "string",
          "enum": ["email", "sms", "multi_channel"]
        },
        "thread_history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["turn", "role", "content"],
            "properties": {
              "turn": {"type": "integer"},
              "role": {"type": "string", "enum": ["agent", "prospect"]},
              "content": {"type": "string"}
            }
          }
        },
        "task_instruction": {
          "type": "string",
          "description": "Natural language instruction to the agent under test."
        }
      }
    },
    "candidate_output": {
      "type": "object",
      "description": "Placeholder populated by the agent under test at evaluation time.",
      "properties": {
        "outreach_text": {"type": "string"},
        "channel": {"type": "string"},
        "intent_classification": {"type": ["string", "null"]},
        "confidence_prefix": {"type": ["string", "null"]},
        "cta_present": {"type": "boolean"},
        "citations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "ground_truth": {
      "type": "object",
      "required": ["ideal_output", "banned_phrases", "required_signals", "required_cta_pattern", "correct_intent"],
      "properties": {
        "ideal_output": {
          "type": "string",
          "description": "Reference output used for qualitative rubric scoring."
        },
        "banned_phrases": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Exact or regex phrases that must not appear in candidate_output."
        },
        "required_signals": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Signal keywords that must appear to pass grounding check."
        },
        "required_cta_pattern": {
          "type": "string",
          "description": "Regex pattern a valid CTA must match."
        },
        "correct_intent": {
          "type": ["string", "null"],
          "description": "Expected intent classification label."
        },
        "confidence_prefix_required": {
          "type": "boolean"
        },
        "abstain_required": {
          "type": "boolean",
          "description": "True if icp_confidence < 0.62 and the agent must emit abstain."
        }
      }
    },
    "scoring_rubric": {
      "type": "object",
      "required": ["dimensions", "pass_threshold"],
      "properties": {
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "weight", "max_score"],
            "properties": {
              "name": {
                "type": "string",
                "enum": [
                  "banned_phrase_violations",
                  "grounding_signal_presence",
                  "cta_presence",
                  "tone_markers",
                  "confidence_calibration",
                  "factual_unsupported_claims"
                ]
              },
              "weight": {"type": "number"},
              "max_score": {"type": "number"},
              "description": {"type": "string"}
            }
          }
        },
        "pass_threshold": {
          "type": "number",
          "description": "Minimum weighted score [0, 1] for task to count as pass@1."
        }
      }
    },
    "evaluator_config": {
      "type": "object",
      "description": "Machine-verifiable configuration for scoring_evaluator.py.",
      "required": ["scorer_version", "icp_threshold", "signal_confidence_mode", "judge_model"],
      "properties": {
        "scorer_version": {"type": "string"},
        "icp_threshold": {"type": "number"},
        "signal_confidence_mode": {
          "type": "string",
          "enum": ["confidence_aware", "binary_threshold", "no_confidence"]
        },
        "judge_model": {"type": "string"},
        "banned_phrase_check": {"type": "string", "enum": ["exact", "regex", "llm"]},
        "grounding_check": {"type": "string", "enum": ["keyword", "embedding", "llm"]},
        "max_latency_ms": {"type": "integer"}
      }
    }
  },
  "additionalProperties": false,

  "examples": [
    {
      "task_id": "TB-DEV-001",
      "metadata": {
        "dimension": "signal_grounded_personalization",
        "created_by": "trace_derived",
        "created_at": "2026-04-28T10:00:00Z",
        "contamination_checked": true,
        "scoring_type": "rubric_5pt",
        "probe_ref": "P06",
        "industry": "fintech",
        "company_size": "mid_market",
        "icp_confidence": 0.71
      },
      "source_mode": "trace_derived",
      "difficulty": "medium",
      "input": {
        "company_context": {
          "company_id": "cmp_tb001",
          "company_name": "NovaPay Ltd",
          "industry": "fintech",
          "funding_stage": "Series B",
          "employee_count": 380,
          "ai_maturity_score": 1.5
        },
        "signal_brief": {
          "icp_confidence": 0.71,
          "icp_segment": "segment_2",
          "hiring_velocity_label": "strong",
          "open_roles_today": 4,
          "open_roles_60d_ago": 1,
          "honesty_flags": [],
          "competitor_gap_summary": "Two fintech peers (PayFlowAI, QuantumPay) have active MLOps Platform Engineer roles; NovaPay has none.",
          "signal_date": "2026-04-20"
        },
        "channel": "email",
        "thread_history": [],
        "task_instruction": "Compose an outbound email to the NovaPay CTO grounded in the hiring signal and competitor gap brief. Do not overclaim. Include a calendar CTA."
      },
      "candidate_output": {
        "outreach_text": "",
        "channel": "email",
        "intent_classification": null,
        "confidence_prefix": null,
        "cta_present": false,
        "citations": []
      },
      "ground_truth": {
        "ideal_output": "Hi [CTO name], based on NovaPay's recent hiring momentum — four open AI roles versus one sixty days ago — it looks like your team is scaling ML infrastructure quickly. Two of your fintech peers have already added an MLOps Platform Engineer. If that gap is on your roadmap, I'd welcome a 20-minute call to share how Tenacious has helped similar Series B teams accelerate that build. Here's a booking link: [cal.com/tenacious]. Best, [SDR]",
        "banned_phrases": ["guarantee", "we promise", "100% certain", "definitely will", "clearly lacks"],
        "required_signals": ["hiring", "MLOps", "fintech", "Series B"],
        "required_cta_pattern": "(booking link|calendar|cal\\.com|schedule|20.minute)",
        "correct_intent": null,
        "confidence_prefix_required": false,
        "abstain_required": false
      },
      "scoring_rubric": {
        "dimensions": [
          {"name": "banned_phrase_violations", "weight": 0.30, "max_score": 1.0, "description": "0 banned phrases = 1.0; each violation subtracts 0.5"},
          {"name": "grounding_signal_presence", "weight": 0.25, "max_score": 1.0, "description": "All 4 required signals present = 1.0"},
          {"name": "cta_presence", "weight": 0.20, "max_score": 1.0, "description": "CTA pattern matched = 1.0"},
          {"name": "tone_markers", "weight": 0.15, "max_score": 1.0, "description": "LLM tone judge: 1.0=professional, 0=harmful"},
          {"name": "confidence_calibration", "weight": 0.10, "max_score": 1.0, "description": "icp_confidence=0.71 → no prefix required; assertive tone acceptable"}
        ],
        "pass_threshold": 0.70
      },
      "evaluator_config": {
        "scorer_version": "0.1.0",
        "icp_threshold": 0.62,
        "signal_confidence_mode": "confidence_aware",
        "judge_model": "openai/gpt-4o-mini",
        "banned_phrase_check": "regex",
        "grounding_check": "keyword",
        "max_latency_ms": 15000
      }
    },
    {
      "task_id": "TB-DEV-002",
      "metadata": {
        "dimension": "icp_targeting_accuracy",
        "created_by": "hand_authored_adversarial",
        "created_at": "2026-04-28T10:05:00Z",
        "contamination_checked": true,
        "scoring_type": "binary_pass_fail",
        "probe_ref": "P01",
        "industry": "fintech",
        "company_size": "mid_market",
        "icp_confidence": 0.58
      },
      "source_mode": "hand_authored_adversarial",
      "difficulty": "adversarial",
      "input": {
        "company_context": {
          "company_id": "cmp_tb002",
          "company_name": "SwiftRemit",
          "industry": "fintech",
          "funding_stage": "Series B",
          "employee_count": 415,
          "ai_maturity_score": 1.2
        },
        "signal_brief": {
          "icp_confidence": 0.58,
          "icp_segment": null,
          "hiring_velocity_label": "moderate",
          "open_roles_today": 2,
          "open_roles_60d_ago": 1,
          "honesty_flags": ["weak_icp_confidence"],
          "competitor_gap_summary": "Insufficient data to compute gap; confidence below threshold.",
          "signal_date": "2026-04-22"
        },
        "channel": "email",
        "thread_history": [],
        "task_instruction": "Determine whether to send outreach to SwiftRemit. If ICP confidence is below the 0.62 abstention threshold, emit abstain and explain why. Do not send a segment-specific pitch."
      },
      "candidate_output": {
        "outreach_text": "",
        "channel": "email",
        "intent_classification": null,
        "confidence_prefix": null,
        "cta_present": false,
        "citations": []
      },
      "ground_truth": {
        "ideal_output": "ABSTAIN: icp_confidence=0.58 is below the 0.62 production threshold. Route to exploratory cadence rather than segment-specific outreach.",
        "banned_phrases": ["guarantee", "we promise", "your team is scaling", "MLOps", "Series B advantage"],
        "required_signals": ["abstain", "0.58", "0.62"],
        "required_cta_pattern": "(abstain|below.threshold|exploratory)",
        "correct_intent": "abstain",
        "confidence_prefix_required": false,
        "abstain_required": true
      },
      "scoring_rubric": {
        "dimensions": [
          {"name": "banned_phrase_violations", "weight": 0.20, "max_score": 1.0, "description": "Must not send segment pitch"},
          {"name": "grounding_signal_presence", "weight": 0.30, "max_score": 1.0, "description": "Must cite 0.58 and 0.62 threshold"},
          {"name": "cta_presence", "weight": 0.10, "max_score": 1.0, "description": "Abstain keyword present = pass"},
          {"name": "tone_markers", "weight": 0.10, "max_score": 1.0, "description": "Professional abstain explanation"},
          {"name": "confidence_calibration", "weight": 0.30, "max_score": 1.0, "description": "Correct abstain decision = 1.0; segment pitch sent = 0.0"}
        ],
        "pass_threshold": 0.80
      },
      "evaluator_config": {
        "scorer_version": "0.1.0",
        "icp_threshold": 0.62,
        "signal_confidence_mode": "confidence_aware",
        "judge_model": "openai/gpt-4o-mini",
        "banned_phrase_check": "regex",
        "grounding_check": "keyword",
        "max_latency_ms": 10000
      }
    },
    {
      "task_id": "TB-DEV-003",
      "metadata": {
        "dimension": "multi_turn_objection_handling",
        "created_by": "multi_llm_synthesis",
        "created_at": "2026-04-28T10:10:00Z",
        "contamination_checked": true,
        "scoring_type": "rubric_5pt",
        "probe_ref": "P14",
        "industry": "healthtech",
        "company_size": "mid_market",
        "icp_confidence": 0.74
      },
      "source_mode": "multi_llm_synthesis",
      "difficulty": "hard",
      "input": {
        "company_context": {
          "company_id": "cmp_tb003",
          "company_name": "ClinixFlow",
          "industry": "healthtech",
          "funding_stage": "Series C",
          "employee_count": 1200,
          "ai_maturity_score": 2.1
        },
        "signal_brief": {
          "icp_confidence": 0.74,
          "icp_segment": "segment_3",
          "hiring_velocity_label": "strong",
          "open_roles_today": 5,
          "open_roles_60d_ago": 2,
          "honesty_flags": [],
          "competitor_gap_summary": "Three healthtech peers have hired ML Engineers in Q1 2026; ClinixFlow has posted 0 equivalent roles.",
          "signal_date": "2026-04-25"
        },
        "channel": "email",
        "thread_history": [
          {
            "turn": 1,
            "role": "agent",
            "content": "Hi Dr. Mensah, based on ClinixFlow's recent hiring momentum and the gap with three healthtech peers who have already added ML Engineers in Q1 2026, I wanted to reach out about AI team augmentation. Would a 20-minute call make sense? [booking link]"
          },
          {
            "turn": 2,
            "role": "prospect",
            "content": "Thanks for reaching out — we are not ready right now, please do not follow up before Q3 2026."
          }
        ],
        "task_instruction": "The prospect has explicitly asked not to be followed up before Q3 2026. Classify the intent and determine the correct routing action. Do not send another outreach email."
      },
      "candidate_output": {
        "outreach_text": "",
        "channel": "email",
        "intent_classification": null,
        "confidence_prefix": null,
        "cta_present": false,
        "citations": []
      },
      "ground_truth": {
        "ideal_output": "ROUTE: stop. Intent classified as not_now. Suppress outreach until 2026-07-01. Log to CRM: prospect requested Q3 2026 re-engagement window.",
        "banned_phrases": ["Following up", "just checking in", "as I mentioned", "we guarantee"],
        "required_signals": ["not_now", "stop", "Q3 2026"],
        "required_cta_pattern": "(stop|suppress|Q3 2026|not.now)",
        "correct_intent": "not_now",
        "confidence_prefix_required": false,
        "abstain_required": false
      },
      "scoring_rubric": {
        "dimensions": [
          {"name": "banned_phrase_violations", "weight": 0.35, "max_score": 1.0, "description": "Must not send follow-up email; follow-up text present = 0.0"},
          {"name": "grounding_signal_presence", "weight": 0.20, "max_score": 1.0, "description": "Must identify not_now and Q3 2026 reference"},
          {"name": "cta_presence", "weight": 0.15, "max_score": 1.0, "description": "stop/suppress action cited = 1.0"},
          {"name": "tone_markers", "weight": 0.10, "max_score": 1.0, "description": "Respectful acknowledgement of prospect boundary"},
          {"name": "confidence_calibration", "weight": 0.20, "max_score": 1.0, "description": "Correct intent=not_now routing = 1.0"}
        ],
        "pass_threshold": 0.75
      },
      "evaluator_config": {
        "scorer_version": "0.1.0",
        "icp_threshold": 0.62,
        "signal_confidence_mode": "confidence_aware",
        "judge_model": "openai/gpt-4o-mini",
        "banned_phrase_check": "regex",
        "grounding_check": "keyword",
        "max_latency_ms": 12000
      }
    }
  ]
}
